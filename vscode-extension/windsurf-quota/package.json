{
  "name": "windsurf-quota",
  "displayName": "Windsurf Quota",
  "description": "Shows Windsurf daily quota % and extra usage balance in the status bar. Click to trigger a live sync.",
  "version": "1.1.0",
  "publisher": "BrightClick",
  "license": "MIT",
  "homepage": "https://github.com/BrightClick/windsurf-ide-widget",
  "repository": {
    "type": "git",
    "url": "https://github.com/BrightClick/windsurf-ide-widget.git"
  },
  "bugs": {
    "url": "https://github.com/BrightClick/windsurf-ide-widget/issues"
  },
  "keywords": ["windsurf", "quota", "status bar", "ai", "usage"],
  "icon": "icon.png",
  "engines": { "vscode": "^1.75.0" },
  "categories": ["Other"],
  "activationEvents": ["*"],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "Windsurf Quota",
      "properties": {
        "windsurfQuota.jsonPath": {
          "type": "string",
          "default": "",
          "description": "Full path to quota_latest.json (e.g. C:\\Projects\\windsurf_api\\quota_latest.json)"
        },
        "windsurfQuota.refreshIntervalSeconds": {
          "type": "number",
          "default": 60,
          "description": "How often to re-read the file (seconds)"
        },
        "windsurfQuota.scriptPath": {
          "type": "string",
          "default": "",
          "description": "Full path to windsurf_quota.py (e.g. /home/user/windsurf-quota/windsurf_quota.py)"
        },
        "windsurfQuota.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Python executable to use for running the sync script (e.g. python, python3, pythonw, or full path)"
        },
        "windsurfQuota.dashboardUrl": {
          "type": "string",
          "default": "http://windsurf_api.test/",
          "description": "URL of the PHP dashboard (served by Laragon)."
        }
      }
    },
    "commands": [
      {
        "command": "windsurfQuota.refresh",
        "title": "Windsurf Quota: Refresh Now"
      },
      {
        "command": "windsurfQuota.openDashboard",
        "title": "Windsurf Quota: Open Dashboard"
      }
    ]
  }
}
